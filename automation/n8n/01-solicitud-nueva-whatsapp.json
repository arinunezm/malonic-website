{
  "name": "Malonic · Solicitud nueva → WhatsApp",
  "nodes": [
    {
      "name": "Webhook Supabase (INSERT requests)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "malonic-solicitud-nueva",
        "responseMode": "onReceived"
      }
    },
    {
      "name": "Leer documento CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        160
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MALONIC_SUPABASE_URL }}/rest/v1/documents?key=eq.malonic-crm&select=data",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.MALONIC_SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MALONIC_SUPABASE_SERVICE_KEY }}"
            }
          ]
        }
      }
    },
    {
      "name": "Armar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Solicitud del webhook + teléfono configurable desde el portal.\nconst hook = $('Webhook Supabase (INSERT requests)').first().json;\nconst r = hook.record ?? hook;\nif (!r || !r.name) return [];\nconst rows = $input.first().json;\nconst doc = Array.isArray(rows) ? rows[0]?.data : rows?.data;\nconst telefono = (doc && doc.settings && doc.settings.notifyPhone) || $env.MALONIC_NICO_PHONE;\nif (!telefono) return [];\nconst partes = [\n  `🎙 Nueva solicitud en malonicrecords`,\n  `${r.name} · ${r.email}`,\n  r.service ? `Servicio: ${r.service}` : null,\n  r.project ? `Proyecto: ${r.project}` : null,\n  r.message ? `“${String(r.message).slice(0, 180)}”` : null,\n  `Revisar: https://malonic-website.vercel.app/admin`,\n].filter(Boolean);\nreturn [{ json: { mensaje: partes.join('\\n'), telefono } }];"
      }
    },
    {
      "name": "WhatsApp a Nico",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v25.0/{{ $env.MALONIC_WA_PHONE_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.MALONIC_WA_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.telefono, type: 'template', template: { name: 'malonic_notificacion', language: { code: 'es_MX' }, components: [{ type: 'body', parameters: [{ type: 'text', text: $json.mensaje }] }] } }) }}"
      }
    }
  ],
  "connections": {
    "Webhook Supabase (INSERT requests)": {
      "main": [
        [
          {
            "node": "Leer documento CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Leer documento CRM": {
      "main": [
        [
          {
            "node": "Armar mensaje",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Armar mensaje": {
      "main": [
        [
          {
            "node": "WhatsApp a Nico",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}